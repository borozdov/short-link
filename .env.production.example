# Copy to .env.production and fill in real values. Never commit .env.production.

# --- db service ---
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shortlink

# --- web/Caddy service ---
# Real domain pointed at this server (A/AAAA record) — Caddy issues a Let's Encrypt
# cert for it automatically. Use "localhost" only for a local docker-compose smoke test.
DOMAIN=your-domain.example

# --- api service ---
# PORT must stay 4000 — apps/web/Caddyfile and apps/api/Dockerfile both hardcode it.
PORT=4000
BASE_LINK_DOMAIN=https://your-domain.example
BASE_FALLBACK_URL=https://borozdov.ru
IP_HASH_SALT=change-me-to-a-long-random-string
